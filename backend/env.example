PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres (transaction pooler recommended)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMS notifications (optional)
# - none: disabled
# - console: logs SMS to server console (for testing)
# - twilio: sends real SMS (requires Twilio credentials)
SMS_ENABLED=false
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email notifications (Gmail SMTP)
EMAIL_ENABLED=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

## Create a `backend/.env` file manually and copy these values.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres (choose ONE approach)
#
# A) Direct connection string (recommended for backend with `pg`)
# Get it from: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=

# Optional: Supabase API (only needed if you later use supabase-js / REST / Storage)
# Get it from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

## Backend environment variables
## Create a `.env` file manually and copy these values.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ejo_support
DATABASE_URL=

# Auth
# Use a long random string in production.
JWT_SECRET=change-me



